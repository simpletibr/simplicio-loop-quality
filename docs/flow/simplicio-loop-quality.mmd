        store_contracts[("Canonical Contract Schemas & Strict Policies")]:::storeStyle
        store_journal_events[("Immutable Quality Event Journal & Ledger Store")]:::storeStyle
    end

    subgraph Outputs ["Saídas e Vereditos"]
        out_asolaria_receipt["ASOLARIA Tri-Vantage Quorum Receipt"]:::outputStyle
        out_evidence_manifest["Immutable Quality Evidence Manifest & Receipts"]:::outputStyle
        out_gate_verdict["Fail-Closed Quality Gate Verdict (quality-evidence.json)"]:::outputStyle
        out_quality_plan["Quality Task Plan (quality-task.md / JSON)"]:::outputStyle
        out_rc_bundle["Signed Release Candidate Bundle & Provenance"]:::outputStyle
        out_remediation_report["Structured Remediation Findings Report for Loop Recovery"]:::outputStyle
    end

    %% Conexões determinísticas
    in_cli -->|"command request"| step_quality_planner
    in_evidence_receipts -->|"raw receipts"| step_evidence_audit
    in_policy -->|"policy thresholds"| step_quality_planner
    in_provider -->|"handshake"| step_negotiation
    in_repo_sources -->|"scan workspace"| step_quality_planner
    step_asolaria_quorum -->|"3-perspective quorum"| out_asolaria_receipt
    step_concurrency_perf -->|"metrics receipts"| step_evidence_audit
    step_evidence_audit -->|"audited evidence"| step_asolaria_quorum
