    step_stage_graph -->|"static stage"| step_static_quality
    step_stage_graph -->|"supply chain stage"| step_supply_chain
    step_stage_graph -->|"e2e stage"| step_system_e2e
    step_stage_graph -->|"unit stage"| step_unit_testing
    step_static_quality -->|"static findings"| step_evidence_audit
    step_supply_chain -->|"sbom digests"| step_evidence_audit
    step_system_e2e -->|"scenario traces"| step_evidence_audit
    step_unit_testing -->|"unit evidence"| step_evidence_audit
    step_waivers_evaluation -->|"approved waivers"| step_quality_gate
