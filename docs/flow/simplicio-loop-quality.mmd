%% Auto-generated deterministic Mermaid flow for simplicio-loop-quality (simplicio.flow/v1)
flowchart TD
    classDef inputStyle fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef stepStyle fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a;
    classDef storeStyle fill:#fef3c7,stroke:#d97706,stroke-width:1.5px,color:#92400e;
    classDef outputStyle fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#15803d;

    subgraph Inputs ["Entradas"]
        in_cli["CLI: simplicio-loop-quality (doctor, plan, run, gate, agents)"]:::inputStyle
        in_evidence_receipts["Execution Receipts: Raw test runner and agent evidence"]:::inputStyle
        in_policy["Quality Policy: Strict Default & Lane Thresholds"]:::inputStyle
        in_provider["Loop Extension Entrypoint: native provider runtime"]:::inputStyle
        in_repo_sources["Repository Sources: Target workspace and test files"]:::inputStyle
    end

    subgraph Steps ["Processamento e Quality Gates (36 Lanes)"]
        step_asolaria_quorum["ASOLARIA Tri-Vantage Quorum Ledger Evaluator"]:::stepStyle
        step_concurrency_perf["Concurrency Reliability & Performance Latency Gates"]:::stepStyle
        step_evidence_audit["Independent Evidence Auditor (Admissibility & Freshness)"]:::stepStyle
        step_fast_conformance["Fast Python/Rust Conformance & Shadow Drift Verifier"]:::stepStyle
        step_mutation_testing["Mutation Testing & Kill Operator Verification"]:::stepStyle
        step_negotiation["Extension Handshake & Atomic Loop Capability Negotiation"]:::stepStyle
        step_property_fuzz["Property-Based & Seeded Fuzzing Quality Lane"]:::stepStyle
        step_quality_gate["Fail-Closed Quality Gate Decision Oracle"]:::stepStyle
        step_quality_planner["36-Lane Quality Plan Compiler & Applicability Matrix"]:::stepStyle
        step_release_candidate["Reproducible Release Candidate Verification & Attestation"]:::stepStyle
        step_remediation_findings["Structured Remediation Findings & Recovery Plan"]:::stepStyle
        step_risk_selection["Impact Analysis & Risk-Based Monotonic Lane Selection"]:::stepStyle
        step_stage_graph["Fan-In Deterministic Quality Stage Graph Compilation"]:::stepStyle
        step_static_quality["Static Quality & Multi-Linter Tool Analysis"]:::stepStyle
        step_supply_chain["Supply Chain, Lockfile Digests & SBOM Validation"]:::stepStyle
        step_system_e2e["System & User-Visible End-to-End Scenarios"]:::stepStyle
        step_unit_testing["Unit & Component Quality Lane Planning and Normalization"]:::stepStyle
        step_waivers_evaluation["Independent Scoped Waiver Selector & Expired Checks"]:::stepStyle
    end

